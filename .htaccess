DirectoryIndex index.html

RewriteEngine On

# Canonicalize: if someone requests /page.html directly, redirect (301) to /page
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Special case: /collections collides with the collections/ subfolder, so the
# generic directory check below would try to list that folder (403) instead of
# serving collections.html. Handle it explicitly first.
RewriteRule ^collections/?$ collections.html [L]

# Internally serve page.html when /page is requested, without changing the visible URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
